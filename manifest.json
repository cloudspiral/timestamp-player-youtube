{
  "manifest_version": 3,
  "name": "Timestamp Player for YouTube",
  "version": "0.8.0",
  "description": "The best way to enjoy albums on YouTube. Automatic timestamp detection, proper playback controls including shuffle, and more.",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "timestamp-player-for-youtube@cloudspiral",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/timestamp-player-youtube-16.png",
    "32": "icons/timestamp-player-youtube-32.png",
    "48": "icons/timestamp-player-youtube-48.png",
    "128": "icons/timestamp-player-youtube-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/settings-sync.js",
        "src/debug.js",
        "src/session-diagnostics.js",
        "src/timestamps.js",
        "src/video-ownership.js",
        "src/dom-visibility.js",
        "src/chapter-data.js",
        "src/native-timestamps.js",
        "src/comment-scoring.js",
        "src/comment-data.js",
        "src/youtube-dom.js",
        "src/youtube-page-data.js",
        "src/comment-fetching.js",
        "src/lru-cache.js",
        "src/watch-route.js",
        "src/track-selection.js",
        "src/fetched-comment-sources.js",
        "src/discovery-status.js",
        "src/discovery-cache.js",
        "src/video-resolver.js",
        "src/watch-session.js",
        "src/track-discovery.js",
        "src/session-media.js",
        "src/watch-mutations.js",
        "src/track-list-renderer.js",
        "src/playback-state.js",
        "src/player-layout.js",
        "src/player-view.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
