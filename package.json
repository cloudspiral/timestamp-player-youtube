{
  "name": "timestamp-player-youtube",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:js": "node scripts/check-javascript.mjs",
    "check:manifest": "node -e \"JSON.parse(require('fs').readFileSync('manifest.json', 'utf8')); console.log('manifest ok')\"",
    "test:timestamps": "node --test tests/timestamps.test.mjs",
    "test:native-timestamps": "node --test tests/native-timestamps.test.mjs",
    "test:video-ownership": "node --test tests/video-ownership.test.mjs",
    "test:dom-visibility": "node --test tests/dom-visibility.test.mjs",
    "test:youtube-dom": "node --test tests/youtube-dom.test.mjs",
    "test:comment-fetching": "node --test tests/comment-fetching.test.mjs",
    "test:comment-data": "node --test tests/comment-data.test.mjs",
    "test:debug": "node --test tests/debug.test.mjs",
    "test:session-diagnostics": "node --test tests/session-diagnostics.test.mjs",
    "test:watch-route": "node --test tests/watch-route.test.mjs",
    "test:track-selection": "node --test tests/track-selection.test.mjs",
    "test:fetched-comment-sources": "node --test tests/fetched-comment-sources.test.mjs",
    "test:track-discovery": "node --test tests/track-discovery.test.mjs",
    "test:discovery-status": "node --test tests/discovery-status.test.mjs",
    "test:lru-cache": "node --test tests/lru-cache.test.mjs",
    "test:discovery-cache": "node --test tests/discovery-cache.test.mjs",
    "test:video-resolver": "node --test tests/video-resolver.test.mjs",
    "test:watch-session": "node --test tests/watch-session.test.mjs",
    "test:session-media": "node --test tests/session-media.test.mjs",
    "test:watch-mutations": "node --test tests/watch-mutations.test.mjs",
    "test:track-list-renderer": "node --test tests/track-list-renderer.test.mjs",
    "test:settings": "node --test tests/settings.test.mjs",
    "test:settings-sync": "node --test tests/settings-sync.test.mjs",
    "test:comment-scoring": "node --test tests/comment-scoring.test.mjs",
    "test:playback-state": "node --test tests/playback-state.test.mjs",
    "test:player-layout": "node --test tests/player-layout.test.mjs",
    "test:player-view": "node --test tests/player-view.test.mjs",
    "test:options": "node --test tests/options.test.mjs",
    "test:tooling": "node --test tests/check-javascript.test.mjs tests/prepare-package-sources.test.mjs tests/verify-package-sources.test.mjs",
    "test": "node --test",
    "check": "npm run check:js && npm run check:manifest && npm test",
    "prepare:packages": "node scripts/prepare-package-sources.mjs",
    "verify:packages": "npm run prepare:packages && node scripts/verify-package-sources.mjs",
    "smoke:chrome": "npm run prepare:packages && node scripts/verify-package-sources.mjs && node scripts/smoke-chrome-extension.mjs",
    "lint:firefox": "npm run prepare:packages && NO_UPDATE_NOTIFIER=1 web-ext lint --source-dir dist/firefox",
    "build:chrome": "npm run prepare:packages && NO_UPDATE_NOTIFIER=1 web-ext build --source-dir dist/chrome --artifacts-dir web-ext-artifacts --overwrite-dest --filename timestamp-player-youtube-chrome-{version}.zip",
    "build:firefox": "npm run prepare:packages && NO_UPDATE_NOTIFIER=1 web-ext build --source-dir dist/firefox --artifacts-dir web-ext-artifacts --overwrite-dest --filename timestamp-player-youtube-firefox-{version}.zip",
    "build": "npm run check && npm run verify:packages && npm run lint:firefox && npm run build:chrome && npm run build:firefox"
  },
  "devDependencies": {
    "web-ext": "^10.6.0"
  }
}
