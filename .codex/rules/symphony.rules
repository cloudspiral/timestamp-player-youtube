# The packaged Chrome smoke test launches an isolated local browser, which
# requires permissions beyond the workspace sandbox. Keep this exception
# limited to the exact audited npm script used by this repository.
prefix_rule(
    pattern = ["npm", "run", "smoke:chrome"],
    decision = "allow",
)

# Git metadata and remote refs are outside the workspace sandbox. This
# host-managed helper validates the exact GH-number worktree, issue branch, and
# GitHub origin before committing or pushing, and disables Git hooks.
prefix_rule(
    pattern = [
        "/Users/matt/bin/timestamp-player-git-handoff",
        "commit",
    ],
    decision = "allow",
)

prefix_rule(
    pattern = [
        "/Users/matt/bin/timestamp-player-git-handoff",
        "push",
    ],
    decision = "allow",
)
